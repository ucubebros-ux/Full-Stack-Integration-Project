@page "/"

<PageTitle>Home</PageTitle>

<div class="welcome-container">
    <div class="welcome-content">
        <h1>Welcome to InventoryHub</h1>
        <p class="lead">A modern inventory management system built with Blazor and minimal APIs</p>
        
        <div class="features">
            <div class="feature-item">
                <h3>Real-time Inventory</h3>
                <p>Track product stock levels in real-time with instant updates</p>
            </div>
            <div class="feature-item">
                <h3>Category Management</h3>
                <p>Organize products by categories for better organization</p>
            </div>
            <div class="feature-item">
                <h3>Price Tracking</h3>
                <p>Monitor product prices and manage your catalog efficiently</p>
            </div>
        </div>

        <div class="cta-section">
            <a href="/fetchproducts" class="btn-primary">View Products</a>
        </div>
    </div>
</div>

<style>
    .welcome-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .welcome-content {
        background: white;
        border-radius: 10px;
        padding: 40px;
        max-width: 600px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .welcome-content h1 {
        font-size: 2.5em;
        color: #333;
        margin-bottom: 10px;
    }

    .lead {
        font-size: 1.2em;
        color: #666;
        margin-bottom: 30px;
    }

    .features {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 20px;
        margin: 30px 0;
    }

    .feature-item {
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .feature-item h3 {
        color: #667eea;
        margin-bottom: 10px;
    }

    .cta-section {
        margin-top: 30px;
    }

    .btn-primary {
        display: inline-block;
        padding: 12px 30px;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        transition: background 0.3s;
    }

    .btn-primary:hover {
        background: #764ba2;
    }

    @media (max-width: 600px) {
        .features {
            grid-template-columns: 1fr;
        }

        .welcome-content h1 {
            font-size: 1.8em;
        }
    }
</style>
